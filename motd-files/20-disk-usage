#!/bin/bash
. /etc/update-motd.d/helper.sh

[[ "$ENABLE_DISK_USAGE" == "n" ]] && exit 0

# Function to get disk data
get_disk_data() {
    # Filter out tmpfs, devtmpfs, squashfs (snaps), and cdroms
    df -hP -x tmpfs -x devtmpfs -x squashfs -x overlay | grep -v "^Filesystem" | sort
}

case "$ENABLE_DISK_USAGE" in
    "short" | "s")
        printf "  ${LBLUE}Disk:${NC} "
        get_disk_data | while read -r _ size used _ perc mount; do
            PERC_VAL=${perc%\%}
            COLOR=$GREEN
            [[ "$PERC_VAL" -ge 80 ]] && COLOR=$YELLOW
            [[ "$PERC_VAL" -ge 90 ]] && COLOR=$RED
            printf "${COLOR}%s %s${NC} " "$mount" "$perc"
        done
        printf "\n"
        ;;
    "table" | "t")
        print_header "Disk Info"
        print_table_header "Mount" "Size" "Used" "Percent" "Status"
        get_disk_data | while read -r _ size used _ perc mount; do
            PERC_VAL=${perc%\%}
            COLOR=$GREEN
            STATUS="OK"
            if [[ "$PERC_VAL" -ge 90 ]]; then
                COLOR=$RED
                STATUS="CRIT"
            elif [[ "$PERC_VAL" -ge 80 ]]; then
                COLOR=$YELLOW
                STATUS="WARN"
            fi
            print_table_row "$mount" "$size" "$used" "${COLOR}${perc}${NC}" "${COLOR}${STATUS}${NC}"
        done
        ;;
    *)
        print_header "Disk Info"
        get_disk_data | while read -r _ size used _ perc mount; do
            PERC_VAL=${perc%\%}
            COLOR=$GREEN
            [[ "$PERC_VAL" -ge 80 ]] && COLOR=$YELLOW
            [[ "$PERC_VAL" -ge 90 ]] && COLOR=$RED
            print_normal_row "$mount:" "$used / $size ($perc)" "$COLOR"
        done
        ;;
esac
