#!/bin/bash
. /etc/update-motd.d/helper.sh

[[ "$ENABLE_SYSINFO" == "n" ]] && exit 0

# Gather System Info
KERNEL=$(uname -r)
UPTIME=$(uptime -p | sed 's/up //')

# Load Average
LOAD=$(awk '{print $1" "$2" "$3}' /proc/loadavg)
LOAD1=${LOAD%% *}

# Memory Usage
MEM_TOTAL=$(free -m | awk '/Mem:/ {print $2}')
MEM_USED=$(free -m | awk '/Mem:/ {print $3}')
MEM_PERC=0
[[ "$MEM_TOTAL" -gt 0 ]] && MEM_PERC=$(( 100 * MEM_USED / MEM_TOTAL ))

# Determine Load Color
LOAD_COLOR=$GREEN
awk -v l="$LOAD1" 'BEGIN {exit !(l > 2.0)}' && LOAD_COLOR=$YELLOW
awk -v l="$LOAD1" 'BEGIN {exit !(l > 4.0)}' && LOAD_COLOR=$RED

# Determine Memory Color
MEM_COLOR=$GREEN
[[ "$MEM_PERC" -ge 75 ]] && MEM_COLOR=$YELLOW
[[ "$MEM_PERC" -ge 90 ]] && MEM_COLOR=$RED

# Hostname
HOST=$(hostname)
HOST_NAME="$HOST"
FQDN=$(hostname -f 2>/dev/null)
[[ -n "$FQDN" && "$FQDN" != "$HOST" ]] && HOST_NAME="$HOST $FQDN"

case "$ENABLE_SYSINFO" in
    "short" | "s")
        printf "  ${LBLUE}Sys:${NC} ${LWHITE}%s${NC} | ${LBLUE}Kernel:${NC} %s | ${LBLUE}Up:${NC} %s | ${LBLUE}Load:${NC} ${LOAD_COLOR}%s${NC} | ${LBLUE}Mem:${NC} ${MEM_COLOR}%s%%${NC}\n" "$HOST" "$KERNEL" "$UPTIME" "$LOAD1" "$MEM_PERC"
        ;;
    "table" | "t")
        print_table_header "Hostname" "Kernel" "Uptime" "Avg. Load" "Memory"
        print_table_row "${LBLUE}$HOST_NAME${NC}" "${LGREEN}$KERNEL${NC}" "${LBLUE}$UPTIME${NC}" "${LOAD_COLOR}$LOAD${NC}" "${MEM_COLOR}${MEM_USED}MB / ${MEM_TOTAL}MB (${MEM_PERC}%)${NC}"
        ;;
    *)
        print_header "SYSTEM STATUS"
        print_normal_row "Hostname:" "$HOST_NAME" "$LWHITE"
        print_normal_row "Kernel:" "$KERNEL"
        print_normal_row "Uptime:" "$UPTIME"
        print_normal_row "Load Average:" "$LOAD" "$LOAD_COLOR"
        print_normal_row "Memory:" "${MEM_USED}MB / ${MEM_TOTAL}MB (${MEM_PERC}%)" "$MEM_COLOR"
        ;;
esac
