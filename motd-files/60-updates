#!/bin/bash
. /etc/update-motd.d/helper.sh

[[ "$ENABLE_UPDATES" == "n" ]] && exit 0

# --- Files ---
UPDATES_FILE="/var/lib/update-notifier/updates-available"
REL_FILE="/var/lib/ubuntu-release-upgrader/release-upgrade-available"
REBOOT_FILE="/var/run/reboot-required"

# --- Package Updates ---
TOTAL=0
SEC=0
if [[ -f "$UPDATES_FILE" ]]; then
    TOTAL=$(awk '/updates can be applied/ {print $1; exit}' "$UPDATES_FILE")
    SEC=$(awk '/security updates/ {print $1; exit}' "$UPDATES_FILE")
    [[ ! "$TOTAL" =~ ^[0-9]+$ ]] && TOTAL=0
    [[ ! "$SEC" =~ ^[0-9]+$ ]] && SEC=0
fi

TOTAL_COLOR=$GREEN
[[ "$TOTAL" -gt 0 ]] && TOTAL_COLOR=$YELLOW
SEC_COLOR=$GREEN
[[ "$SEC" -gt 0 ]] && SEC_COLOR=$RED

# --- Distro Upgrade ---
DISTRO_UPDATE_MSG="None"
if [[ -f "$REL_FILE" ]]; then
    DISTRO_UPDATE_MSG=$(cat "$REL_FILE")
    [[ -z "$DISTRO_UPDATE_MSG" ]] && DISTRO_UPDATE_MSG="None"
fi

# --- Reboot Status ---
REBOOT_STATUS="No"
REBOOT_COLOR=$GREEN
if [[ -f "$REBOOT_FILE" ]]; then
    REBOOT_STATUS="YES"
    REBOOT_COLOR=$RED
fi

case "$ENABLE_UPDATES" in
    "short" | "s")
        printf "  ${LBLUE}Maintenance:${NC} ${TOTAL_COLOR}%s${NC} (Sec: ${SEC_COLOR}%s${NC}). ${LBLUE}Reboot:${NC} ${REBOOT_COLOR}%s${NC} ${LBLUE}Distro:${NC} %s\n" "$TOTAL" "$SEC" "$REBOOT_STATUS" "$DISTRO_UPDATE_MSG"
        ;;
    "table" | "t")
        print_header "Maintenance"
        print_table_header "Updates" "Security" "Distro" "Reboot"
        print_table_row "${TOTAL_COLOR}${TOTAL}${NC}" "${SEC_COLOR}${SEC}${NC}" "$DISTRO_UPDATE_MSG" "${REBOOT_COLOR}${REBOOT_STATUS}${NC}"
        ;;
    *)
        print_header "Maintenance"
        if [[ -f "$UPDATES_FILE" ]]; then
            print_normal_row "Packages to update:" "$TOTAL" "$TOTAL_COLOR"
            print_normal_row "Security updates:" "$SEC" "$SEC_COLOR"
        else
            print_normal_row "Packages to update:" "(Info unavailable)" "$LBLACK"
        fi
        
        [[ "$DISTRO_UPDATE_MSG" != "None" ]] && print_normal_row "Distro Upgrade:" "$DISTRO_UPDATE_MSG" "$LPURPLE" || print_normal_row "Distro Upgrade:" "None" "$GREEN"
        
        if [[ "$REBOOT_STATUS" == "YES" ]]; then
            print_normal_row "Reboot Required:" " YES " "$BG_RED$LWHITE"
        else
            print_normal_row "Reboot Required:" "No" "$GREEN"
        fi
        ;;
esac

