#!/bin/sh
. /etc/update-motd.d/helper.sh

if [ "$ENABLE_UPDATES" = "n" ]; then exit 0; fi

# --- Package Updates ---
# This file is usually generated by /usr/lib/update-notifier/update-motd-updates-available
UPDATES_FILE="/var/lib/update-notifier/updates-available"

# --- Distribution Release Upgrade ---
# Check if a new release is available
REL_FILE="/var/lib/ubuntu-release-upgrader/release-upgrade-available"
DISTRO_UPDATE_MSG=""
if [ -f "$REL_FILE" ]; then
    MSG=$(cat "$REL_FILE")
    # Check if MSG is empty
    if [ -z "$MSG" ]; then
        DISTRO_UPDATE_MSG="none"
    else
        DISTRO_UPDATE_MSG="$MSG"
    fi
fi

# --- Reboot Status ---
REBOOT_STATUS="NO"
REBOOT_COLOR=$GREEN
if [ -f /var/run/reboot-required ]; then
     REBOOT_STATUS="YES"
  REBOOT_COLOR=$RED
fi


if [ -f "$UPDATES_FILE" ]; then
    # Extract counts using awk.
    # We add '; exit' to ensure we stop reading after the first match
    # to prevents capturing duplicate lines or garbage.
    TOTAL=$(awk '/updates can be applied/ {print $1; exit}' "$UPDATES_FILE")
    SEC=$(awk '/security updates/ {print $1; exit}' "$UPDATES_FILE")

    # Sanitize variables:
    # If empty or contains non-digits, default to 0
    case "$TOTAL" in
        ''|*[!0-9]*) TOTAL=0 ;;
    esac

    case "$SEC" in
        ''|*[!0-9]*) SEC=0 ;;
    esac

    # Color Logic
    TOTAL_COLOR=$GREEN
    [ "$TOTAL" -gt 0 ] && TOTAL_COLOR=$YELLOW

    SEC_COLOR=$GREEN
    [ "$SEC" -gt 0 ] && SEC_COLOR=$RED

    case "$ENABLE_UPDATES" in
        "short" | "s")
             printf "  ${LBLUE}Maintenance:${NC} ${TOTAL_COLOR}%s${NC} (Sec: ${SEC_COLOR}%s${NC}). ${LBLUE}Reboot:${NC} ${REBOOT_COLOR}%s${NC} ${LBLUE}Distro updates:${NC} %s \n" "$TOTAL" "$SEC" "$REBOOT_STATUS" "$DISTRO_UPDATE_MSG"
             ;;
        "table" | "t")
             printf "\n${LBLUE} Maintenance ${NC}\n"
             printf " | %-18s | %-18s | %-18s | %-18s |\n" "Package Updates" "Security Updates" "Distro Updates" "Reboot Required"
             printf " | ${TOTAL_COLOR}%18s${NC} | ${SEC_COLOR}%18s${NC} | ${REBOOT_COLOR}%18s${NC} | %18s |\n" "$TOTAL" "$SEC"  "$DISTRO_UPDATE_MSG" "$REBOOT_STATUS"
             ;;
        *)
            printf "\n${LBLUE} Maintenance ${NC}\n"
            printf "  %-20s ${TOTAL_COLOR}%s${NC}\n" "Packages to update:" "$TOTAL"
            printf "  %-20s ${SEC_COLOR}%s${NC}\n" "Security updates:" "$SEC"

            # --- Distribution Release Upgrade ---
            # Check if a new release is available
            REL_FILE="/var/lib/ubuntu-release-upgrader/release-upgrade-available"
            if [ -f "$REL_FILE" ]; then
                MSG=$(cat "$REL_FILE")
                # Check if MSG is empty
                if [ -z "$MSG" ]; then
                    printf "  %-20s ${GREEN}None${NC}\n" "Distro Upgrade:"
                else
                    printf "  %-20s ${LPURPLE}%s${NC}\n" "Distro Upgrade:" "$MSG"
                fi
            fi
        
            # --- Reboot Status ---
            if [ -f /var/run/reboot-required ]; then
                printf "  %-20s ${BG_RED}${LWHITE} YES ${NC}\n" "Reboot Required:"
            else
                printf "  %-20s ${GREEN}No${NC}\n" "Reboot Required:"
            fi
            ;;
    esac
else
    if [ "$ENABLE_UPDATES" != "short" ] && [ "$ENABLE_UPDATES" != "s" ]; then
        print "\n${LBLUE} Maintenance ${NC}\n"
        printf "  %-20s ${LBLACK}Info unavailable${NC}\n" "Packages to update:"
    fi
fi

