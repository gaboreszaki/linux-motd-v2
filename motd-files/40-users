#!/bin/bash
. /etc/update-motd.d/helper.sh

[[ "$ENABLE_USERS" == "n" ]] && exit 0

# 1. Active Users Count
ACTIVE_COUNT=$(who | wc -l)

# 2. Target User
TARGET_USER=${LOGNAME:-$(whoami)}

# 3. Get Previous Login Data
RAW_DATA=$(last -i -n 2 "$TARGET_USER" | head -n 2 | tail -n 1)

L_IP=""
L_DATE=""
LOCATION=""

if [[ -n "$RAW_DATA" && ! "$RAW_DATA" =~ "wtmp starts" ]]; then
    L_IP=$(echo "$RAW_DATA" | awk '{print $3}')
    L_DATE=$(echo "$RAW_DATA" | awk '{print $4, $5, $6, $7}')
    
    # 4. Location Logic
    if [[ "$L_IP" =~ ^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.) ]]; then
        LOCATION="(Local Network)"
    elif [[ "$L_IP" == "0.0.0.0" ]]; then
        LOCATION="(Console)"
    else
        # Public IP location
        GEO_DATA=$(curl -s -m 1 "http://ip-api.com/line/${L_IP}?fields=city,countryCode" 2>/dev/null)
        if [[ -n "$GEO_DATA" ]]; then
            CITY=$(echo "$GEO_DATA" | sed -n '1p')
            CNTRY=$(echo "$GEO_DATA" | sed -n '2p')
            [[ -n "$CITY" && -n "$CNTRY" ]] && LOCATION="(${CITY}, ${CNTRY})"
        fi
    fi
fi

# Display
case "$ENABLE_USERS" in
    "short" | "s")
        printf "  ${LBLUE}Users:${NC} ${LWHITE}%s${NC} active. ${LBLUE}Last:${NC} %s from ${LCYAN}%s${NC} %s\n" "$ACTIVE_COUNT" "$TARGET_USER" "${L_IP:-N/A}" "$LOCATION"
        ;;
    "table" | "t")
        print_header "User info"
        print_table_header "Active" "Last User" "Last IP" "Location"
        print_table_row "$ACTIVE_COUNT" "$TARGET_USER" "${LGREEN}${L_IP:-N/A}${NC}" "${LCYAN}${LOCATION:-N/A}${NC}"
        ;;
    *)
        print_header "User info"
        print_normal_row "Active Sessions:" "$ACTIVE_COUNT" "$LWHITE"
        if [[ -z "$L_IP" ]]; then
            print_normal_row "Last Login:" "(First login or history cleared)" "$LBLACK"
        else
            print_normal_row "User History:" "$TARGET_USER"
            print_normal_row "Previous IP:" "$L_IP $LOCATION" "$LCYAN"
            print_normal_row "Previous Date:" "$L_DATE"
        fi
        ;;
esac